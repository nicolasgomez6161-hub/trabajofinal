# Copiar este archivo como .env y completar con los datos de tu MySQL local.
# ¡NO subir .env a GitHub: contiene credenciales y la clave JWT!

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=tienda_gamer
DB_PORT=3306

# Puerto del servidor Express
PORT=3000

# Clave para firmar los tokens JWT (cambiar en producción)
JWT_SECRET=clave_secreta_tienda_gamer_cambiar_en_produccion
JWT_EXPIRES_IN=2h
