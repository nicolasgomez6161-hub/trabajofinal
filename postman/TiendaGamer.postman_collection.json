        {
          "name": "Registro OK (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/registro",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Usuario Postman\",\n  \"email\": \"postman{{$timestamp}}@test.com\",\n  \"password\": \"admin123\",\n  \"password_confirmacion\": \"admin123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
